# Scraper cache (regenerated on demand). The live scrapers write .source_cache/;
# .scrape_cache/ is kept for any legacy local dirs.
.scrape_cache/
.source_cache/

# Local ML/analytics capture (contains session ids, user-agents and free-text
# feedback incl. emails — must never be committed). Production uses Supabase.
python-api/data/

# Local-only project docs & skills — sensitive business plans (monetisation
# roadmap, launch/campaign strategy) plus the swatch-source PDF live here. The
# whole folder is kept on disk for local context but never committed.
Skills&rules/

# Colour-science audit working files. Local-only for the same reason as
# Skills&rules/: the research notes discuss the swatch source by name, and
# invariant 7 forbids that reaching any published output. Nothing under docs/
# has ever been committed, so no history rewrite is needed — but this folder is
# NOT backed up by the repo. Keep an off-repo copy.
docs/

# Local-only large/offline assets & superseded business-doc duplicates. Kept on
# disk, never committed (also purged from history). The canonical roadmap lives
# in Skills&rules/context/.
# NB: Testimages/ is NOT ignored — it holds fixtures for vision-miniscanner.test.ts.
ml-pipeline/
/SCHEMESTEALER_MEGA_ROADMAP.md
/SCHEMESTEALER_ULTIMATE_ROADMAP.md
/Geminiideas.md
/GrokIdeas.md
/ClaudeIdeas.txt
/1000058499.mp4
/architecture.md.bak

# Bundled external audit plugin — has its own git repo, must not be embedded.
frontend-design-audit/

# Regenerable accuracy-harness outputs (baseline_harness.json IS tracked and
# stays — it is the frozen reference the harness compares against).
python-api/harness_report.json
python-api/report_*.json
python-api/synthetic_scenes/
